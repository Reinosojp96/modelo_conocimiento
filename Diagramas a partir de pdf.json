    {
      "parameters": {
        "jsCode": "return [{\n  text:\n    \"hazme un mapa conceptual en Markdown\\n\\n\" + \n    $input.first().json.text\n      .replace(/\\r?\\n|\\r/g, ' ')   // elimina saltos de línea\n      .replace(/\\t/g, ' ')         // elimina tabulaciones\n      .replace(/\\s{2,}/g, ' ')     // comprime espacios múltiples\n      .replace(/[“”‘’]/g, '\"')     // reemplaza comillas raras\n      .trim()                      // quita espacios al inicio y final\n      .slice(0, 100000)              // corta a los primeros 10000 caracteres\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        240
      ],
      "id": "34ae53aa-b944-4809-932a-928349e0c7fc",
      "name": "Prompt mapa conceptual Markdown"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  text:\n    \"Genera un diagrama de grafos en markdown basado en el siguiente contenido:n\\n\\n\" + \n    $input.first().json.text\n      .replace(/\\r?\\n|\\r/g, ' ')   // elimina saltos de línea\n      .replace(/\\t/g, ' ')         // elimina tabulaciones\n      .replace(/\\s{2,}/g, ' ')     // comprime espacios múltiples\n      .replace(/[“”‘’]/g, '\"')     // reemplaza comillas raras\n      .trim()                      // quita espacios al inicio y final\n      .slice(0, 100000)              // corta a los primeros 10000 caracteres\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        400
      ],
      "id": "1645aba3-c0d8-4d41-8665-e1e30a9be8b3",
      "name": "Prompt grafos markdwon"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  text:\n    \"haz un diagrama de flujo en markdwon de\\n\\n\" + \n    $input.first().json.text\n      .replace(/\\r?\\n|\\r/g, ' ')   // elimina saltos de línea\n      .replace(/\\t/g, ' ')         // elimina tabulaciones\n      .replace(/\\s{2,}/g, ' ')     // comprime espacios múltiples\n      .replace(/[“”‘’]/g, '\"')     // reemplaza comillas raras\n      .trim()                      // quita espacios al inicio y final\n      .slice(0, 100000)              // corta a los primeros 10000 caracteres\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        592
      ],
      "id": "60881734-95b7-4216-9aa2-0fb35a3d7d62",
      "name": "Prompt diagrama de flujo markdown"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    binary: {\n      data: {\n        data: Buffer.from($input.first().json.response, 'utf8').toString('base64'),\n        mimeType: 'text/markdown',\n        fileName: 'diagrama.md'\n      }\n    }\n  }\n];"
      },
